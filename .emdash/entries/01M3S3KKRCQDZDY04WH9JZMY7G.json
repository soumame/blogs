{"createdAt":"2026-09-30T12:11:09.964Z","data":{"body":[{"_key":"p1","_type":"block","children":[{"_key":"p0","_type":"span","marks":[],"text":"HTMLの役目"}],"markDefs":[],"style":"h2"},{"_key":"p5","_type":"block","children":[{"_key":"p2","_type":"span","marks":[],"text":"HTMLは、"},{"_key":"p3","_type":"span","marks":["strong"],"text":"HyperText Markup Language"},{"_key":"p4","_type":"span","marks":[],"text":"と言って、ハイパーテキストを記述する言語。"}],"markDefs":[],"style":"normal"},{"_key":"p7","_type":"block","children":[{"_key":"p6","_type":"span","marks":[],"text":"で、ハイパーテキストっていうのは、今は当たり前となったリンクを通して他の文書と紐づけることができる仕組みがあるテキストファイル。"}],"markDefs":[],"style":"normal"},{"_key":"pb","_type":"block","children":[{"_key":"p8","_type":"span","marks":[],"text":"テキストファイルっていうのは文字を書いておくファイル。("},{"_key":"p9","_type":"span","marks":["code"],"text":".txt"},{"_key":"pa","_type":"span","marks":[],"text":"みたいな。)"}],"markDefs":[],"style":"normal"},{"_key":"pg","_type":"block","children":[{"_key":"pc","_type":"span","marks":[],"text":"で、"},{"_key":"pe","_type":"span","marks":["pd"],"text":"World Wide Web"},{"_key":"pf","_type":"span","marks":[],"text":"の仕組みとして、そういうのがあるので、みんなはリンクをぽちぽちするだけで別のページに移動できる"}],"markDefs":[{"_key":"pd","_type":"link","href":"/ja/misc/world-wide-web/"}],"style":"normal"},{"_key":"pi","_type":"block","children":[{"_key":"ph","_type":"span","marks":[],"text":"なぜプログラミング言語じゃない？"}],"markDefs":[],"style":"h2"},{"_key":"pk","_type":"block","children":[{"_key":"pj","_type":"span","marks":[],"text":"テキストファイルって言われれば、確かに文字が写るだけだからテキストファイルなんだけど、ここまで高機能だと、プログラミング言語って言っちゃうのも自然な気がする。"}],"markDefs":[],"style":"normal"},{"_key":"pm","_type":"block","children":[{"_key":"pl","_type":"span","marks":[],"text":"ただ、HTMLだけでは「ボタンを押したら何かが起きる」実装はできない。何かが起きるようにするためにはJavascriptなどの、HTMLの書き方で定義されていること以外の方法を使わないといけない。"}],"markDefs":[],"style":"normal"},{"_key":"po","_type":"block","children":[{"_key":"pn","_type":"span","marks":[],"text":"まあ現代のブラウザでは、基本的にHTML, CSS, Javascriptとかを一緒に合わせて読み込むので、ボタンを押したら何かが起きるのが当たり前になっている。"}],"markDefs":[],"style":"normal"},{"_key":"pq","_type":"block","children":[{"_key":"pp","_type":"span","marks":[],"text":"基本的には、(まあ最近はCSSで演算もできるので定義は難しいけど)"}],"markDefs":[],"style":"normal"},{"_key":"ps","_type":"block","children":[{"_key":"pr","_type":"span","marks":[],"text":"HTMLが、文章の内容を書いておく場所"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"pu","_type":"block","children":[{"_key":"pt","_type":"span","marks":[],"text":"CSSが、その文章の見た目を決める場所"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"pw","_type":"block","children":[{"_key":"pv","_type":"span","marks":[],"text":"Javascriptが、ボタンを押したら何が起きるかを命令する場所\nみたいな理解でいいのかな。"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"}],"description":"","emoji":"🗒️","exclude_from_listing":0,"is_translated":0,"is_work_in_progress":0,"legacy_editable":{"description":"","emoji":"🗒️","exclude_from_listing":false,"is_translated":false,"is_work_in_progress":false,"legacy_published_at":"2025-10-05","tags":["dev","coding"],"title":"HTMLとは"},"legacy_frontmatter":{"emoji":"🗒️","published_at":"2025-10-05","tags":["dev","coding"],"title":"HTMLとは"},"legacy_path":"ja/misc/html.md","legacy_published_at":"2025-10-05","public_path":"ja/misc/html","tags":["dev","coding"],"title":"HTMLとは"},"id":"01M3S3KKRCQDZDY04WH9JZMY7G","locale":"ja","publishedAt":"2025-10-05T00:00:00.000Z","seo":{"canonical":null,"description":null,"image":null,"noIndex":false,"title":null},"slug":"html","translationGroup":"01M3S3KKRCQDZDY04WH9JZMY7G"}
