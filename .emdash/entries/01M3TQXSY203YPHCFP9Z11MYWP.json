{"createdAt":"2026-10-01T03:25:29.922Z","data":{"body":[{"_key":"p1","_type":"block","children":[{"_key":"p0","_type":"span","marks":[],"text":"GitHub Student Packとは？"}],"markDefs":[],"style":"h1"},{"_key":"p3","_type":"block","children":[{"_key":"p2","_type":"span","marks":[],"text":"GitHubが学生に対して有料のソフトウェアや無料のサーバークレジット、GitHub Proプランなどを無料で提供しているパッケージの名前です。"}],"markDefs":[],"style":"normal"},{"_key":"p5","_type":"block","children":[{"_key":"p4","_type":"span","marks":[],"text":"日本だと、学生証の写真とか、学校発行のeメールアドレスとかを登録するだけで使えます。総額いくらなのかわかりませんが、使いきれないくらいの量があるので、GitHub使う人は絶対に登録しましょう。やらないと損なレベル。"}],"markDefs":[],"style":"normal"}],"date_precision":"day","description":"","emoji":"⚒️","hidden_from_listing":false,"is_work_in_progress":true,"properties":{},"published_updated_at":"2025-10-05T00:00:00.000Z","title":"GitHub Student Pack","translation":null},"id":"01M3TQXSY203YPHCFP9Z11MYWP","locale":"ja","publishedAt":"2025-10-05T00:00:00.000Z","seo":{"canonical":null,"description":null,"image":null,"noIndex":false,"title":null},"slug":"github-student-pack","terms":{"category":[{"id":"01M40J9F7FY1GFDY2YD68CSPVN","label":"雑記","locale":"ja","name":"category","parentId":null,"slug":"misc","translationGroup":"01M40J9EZG7N7XMZG3TAFYBE98"}],"tag":[{"id":"01M40J9PJF3FARKX199M7460AQ","label":"coding","locale":"ja","name":"tag","parentId":null,"slug":"coding","translationGroup":"01M40J9P9QVX3HS9J0D0SDRD90"},{"id":"01M40J9QJ80RY4CTXQSA4CTJ6A","label":"dev","locale":"ja","name":"tag","parentId":null,"slug":"dev","translationGroup":"01M40J9Q9ZTBA6GQGRV3E9D2YK"},{"id":"01M40J9YFYDHWFDNDP4JMRMMPC","label":"team-dev","locale":"ja","name":"tag","parentId":null,"slug":"team-dev","translationGroup":"01M40J9Y713CQ7RETX92T6DX37"}]},"translationGroup":"01M3TQXSY203YPHCFP9Z11MYWP"}
