{"createdAt":"2026-10-01T03:25:30.047Z","data":{"body":[{"_key":"p1","_type":"block","children":[{"_key":"p0","_type":"span","marks":[],"text":"20年は、7300日。\n成人してもまだ1万一も生きてないことになる\nコンピューターの世界では1万なんて本当に小さな数字なのに。\n８０年生きても3万日に満たない。\nしかも、そのうちの1/3以上は寝ている。\n自分はいつまで成長し続けるのかな？"}],"markDefs":[],"style":"normal"}],"date_precision":"day","description":"よくよく考えたら自分は今年で20歳なわけだけど、あと何年生きるんだろうか？","emoji":"🎇","hidden_from_listing":true,"is_work_in_progress":true,"properties":{},"published_updated_at":"2026-04-28T00:00:00.000Z","title":"人生って短い","translation":null},"id":"01M3TQXT1ZE37AVQ9DTQ9MH3A6","locale":"ja","publishedAt":"2026-04-28T00:00:00.000Z","seo":{"canonical":null,"description":null,"image":null,"noIndex":true,"title":null},"slug":"life-is-short","terms":{"category":[{"id":"01M40J9F7FY1GFDY2YD68CSPVN","label":"雑記","locale":"ja","name":"category","parentId":null,"slug":"misc","translationGroup":"01M40J9EZG7N7XMZG3TAFYBE98"}],"tag":[{"id":"01M40J9RKAYMSYMEEQVNB914XS","label":"essay","locale":"ja","name":"tag","parentId":null,"slug":"essay","translationGroup":"01M40J9RBDGJT2EZXDA1B5AWCC"}]},"translationGroup":"01M3TQXT1ZE37AVQ9DTQ9MH3A6"}
