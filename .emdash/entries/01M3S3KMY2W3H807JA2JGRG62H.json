{"createdAt":"2026-09-30T12:11:11.170Z","data":{"body":[{"_key":"p1","_type":"block","children":[{"_key":"p0","_type":"span","marks":[],"text":"The role of HTML"}],"markDefs":[],"style":"h2"},{"_key":"p5","_type":"block","children":[{"_key":"p2","_type":"span","marks":[],"text":"HTML stands for "},{"_key":"p3","_type":"span","marks":["strong"],"text":"HyperText Markup Language"},{"_key":"p4","_type":"span","marks":[],"text":", and is a language for describing hypertext."}],"markDefs":[],"style":"normal"},{"_key":"p7","_type":"block","children":[{"_key":"p6","_type":"span","marks":[],"text":"Hypertext is a text file that has a mechanism for linking to other documents via links — something that's commonplace now."}],"markDefs":[],"style":"normal"},{"_key":"pb","_type":"block","children":[{"_key":"p8","_type":"span","marks":[],"text":"A text file is a file where you write characters. ("},{"_key":"p9","_type":"span","marks":["code"],"text":".txt"},{"_key":"pa","_type":"span","marks":[],"text":", for example.)"}],"markDefs":[],"style":"normal"},{"_key":"pg","_type":"block","children":[{"_key":"pc","_type":"span","marks":[],"text":"And as part of the "},{"_key":"pe","_type":"span","marks":["pd"],"text":"World Wide Web"},{"_key":"pf","_type":"span","marks":[],"text":" system, because of this, people can move to other pages just by clicking links."}],"markDefs":[{"_key":"pd","_type":"link","href":"/en/misc/world-wide-web/"}],"style":"normal"},{"_key":"pi","_type":"block","children":[{"_key":"ph","_type":"span","marks":[],"text":"Why isn't it a programming language?"}],"markDefs":[],"style":"h2"},{"_key":"pk","_type":"block","children":[{"_key":"pj","_type":"span","marks":[],"text":"If you call it a text file, it's true that it's just characters, so it's a text file, but given how capable it has become, it might feel natural to call it a programming language."}],"markDefs":[],"style":"normal"},{"_key":"pm","_type":"block","children":[{"_key":"pl","_type":"span","marks":[],"text":"However, HTML alone cannot implement \"something happens when you press a button.\" To make things happen you need to use methods outside what HTML's syntax defines, such as JavaScript."}],"markDefs":[],"style":"normal"},{"_key":"po","_type":"block","children":[{"_key":"pn","_type":"span","marks":[],"text":"In modern browsers, HTML, CSS, and JavaScript are generally loaded together, so it's become normal that pressing a button triggers some action."}],"markDefs":[],"style":"normal"},{"_key":"pq","_type":"block","children":[{"_key":"pp","_type":"span","marks":[],"text":"Basically (well, recently CSS can also perform calculations so definitions are tricky),"}],"markDefs":[],"style":"normal"},{"_key":"ps","_type":"block","children":[{"_key":"pr","_type":"span","marks":[],"text":"HTML is where you write the document's content"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"pu","_type":"block","children":[{"_key":"pt","_type":"span","marks":[],"text":"CSS is where you determine how that content looks"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"pw","_type":"block","children":[{"_key":"pv","_type":"span","marks":[],"text":"JavaScript is where you instruct what happens when a button is pressed"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"py","_type":"block","children":[{"_key":"px","_type":"span","marks":[],"text":"That's roughly the right way to understand it, I guess."}],"markDefs":[],"style":"normal"}],"date_precision":"day","description":"","emoji":"🗒️","hidden_from_listing":false,"is_work_in_progress":false,"properties":{},"published_updated_at":"2025-10-05T00:00:00.000Z","title":"What is HTML","translation":{"automatic":true,"sourceId":"01M3S3KKRCQDZDY04WH9JZMY7G"}},"id":"01M3S3KMY2W3H807JA2JGRG62H","locale":"en","publishedAt":"2025-10-05T00:00:00.000Z","seo":{"canonical":null,"description":null,"image":null,"noIndex":false,"title":null},"slug":"html","terms":{"category":[{"id":"01M40J9EZG7N7XMZG3TAFYBE98","label":"Miscellaneous","locale":"en","name":"category","parentId":null,"slug":"misc","translationGroup":"01M40J9EZG7N7XMZG3TAFYBE98"}],"tag":[{"id":"01M40J9P9QVX3HS9J0D0SDRD90","label":"coding","locale":"en","name":"tag","parentId":null,"slug":"coding","translationGroup":"01M40J9P9QVX3HS9J0D0SDRD90"},{"id":"01M40J9Q9ZTBA6GQGRV3E9D2YK","label":"dev","locale":"en","name":"tag","parentId":null,"slug":"dev","translationGroup":"01M40J9Q9ZTBA6GQGRV3E9D2YK"}]},"translationGroup":"01M3S3KKRCQDZDY04WH9JZMY7G"}
